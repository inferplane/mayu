{
  "_comment": "Illustrative endpoints, model IDs, capabilities and USD-per-million-token rates: replace and verify all before use. Run from repository root. Boundary labels are operator assertions.",
  "server": {
    "listen": "127.0.0.1:8080",
    "admin_listen": "127.0.0.1:9090",
    "admin_auth": {
      "token_refs": [
        {
          "env": "INFERPLANE_ADMIN_TOKEN"
        }
      ]
    }
  },
  "key_store": {
    "type": "sqlite",
    "path": "/tmp/inferplane-policy-routing-demo/keys.db"
  },
  "audit": {
    "failure_mode": "buffer_then_block",
    "buffer": {
      "path": "/tmp/inferplane-policy-routing-demo/audit.wal"
    },
    "sinks": [
      {
        "type": "file",
        "path": "/tmp/inferplane-policy-routing-demo/audit.jsonl"
      }
    ]
  },
  "policies": [
    "examples/policy-routing/governance.yaml"
  ],
  "providers": {
    "approved-public": {
      "type": "openai_compatible",
      "base_url": "https://public-models.example.invalid/v1",
      "data_boundary": "external",
      "api_key_ref": {
        "env": "POLICY_ROUTING_PUBLIC_KEY"
      }
    },
    "approved-private": {
      "type": "openai_compatible",
      "base_url": "https://private-models.example.invalid/v1",
      "data_boundary": "internal",
      "api_key_ref": {
        "env": "POLICY_ROUTING_PRIVATE_KEY"
      }
    }
  },
  "models": {
    "premium-coder": {
      "aliases": [
        "premium-coder-alias"
      ],
      "context_window": 32768,
      "capabilities": [
        "tools"
      ],
      "targets": [
        {
          "provider": "approved-public",
          "model": "premium-v1"
        }
      ]
    },
    "economy-coder": {
      "aliases": [
        "economy-coder-alias"
      ],
      "context_window": 32768,
      "capabilities": [
        "tools"
      ],
      "targets": [
        {
          "provider": "approved-public",
          "model": "economy-v1"
        }
      ]
    },
    "private-coder": {
      "aliases": [
        "private-coder-alias"
      ],
      "context_window": 32768,
      "capabilities": [
        "tools"
      ],
      "targets": [
        {
          "provider": "approved-private",
          "model": "private-v1"
        }
      ]
    }
  },
  "model_fallback_family": false,
  "teams": {
    "engineering": {
      "allowed_models": [
        "premium-coder",
        "economy-coder",
        "private-coder"
      ]
    }
  },
  "pricing": {
    "on_missing": "block",
    "version": "illustrative-policy-routing-v1",
    "overrides": {
      "approved-public": {
        "premium-v1": {
          "input_per_mtok": 5,
          "output_per_mtok": 15
        },
        "economy-v1": {
          "input_per_mtok": 1,
          "output_per_mtok": 3
        }
      },
      "approved-private": {
        "private-v1": {
          "input_per_mtok": 2,
          "output_per_mtok": 4
        }
      }
    }
  }
}
